<?xml version="1.0" encoding="utf-8"?>
<!-- PseudoMagic flight, a Ring of the Mage power (DC 6, Phases 6 and 7): landing node. Keeps the standing pose, is short, and ends the landing
     state the way the vanilla land_* nodes do (bLandAnimFinished=true). Same structure as KintoUn's land node. -->
<animNode>
	<m_Name>PseudoMagicFlight_land</m_Name>
	<m_AnimName>Bob_Idle</m_AnimName>
	<m_Priority>20</m_Priority>
	<m_ConditionPriority>50</m_ConditionPriority>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.10</m_BlendTime>
	<m_BlendOutTime>0.20</m_BlendOutTime>
	<m_EarlyTransitionOut>true</m_EarlyTransitionOut>
	<m_SpeedScale>4.00</m_SpeedScale>
	<m_Conditions x_name="pseudomagicflight-land">
		<m_Name>PseudoMagicFlying</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions x_name="pseudomagicflight-land-b">
		<m_Name>bFalling</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>false</m_Value>
	</m_Conditions>
	<m_Events x_name="pseudomagicflight-land-e">
		<m_EventName>SetVariable</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>bLandAnimFinished=true</m_ParameterValue>
	</m_Events>
</animNode>
